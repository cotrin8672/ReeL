#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/mouse.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            /*
             * Initial hardware bring-up map. The first two keys on the
             * bottom-left row are the encoder-axis tact switches.
             */
            bindings = <
                &kp Q     &kp W     &kp E     &kp R     &kp T              &kp Y      &kp U     &kp I     &kp O     &kp P
                &kp A     &kp S     &kp D     &kp F     &kp G     &kp H   &kp J      &kp K     &kp L     &kp SEMI  &kp SQT
                &kp Z     &kp X     &kp C     &kp V     &kp B     &kp N   &kp M      &kp COMMA &kp DOT   &kp FSLH  &kp ESC
                &mkp LCLK &mkp RCLK &kp LCTRL &kp LALT  &kp SPACE           &kp ENTER  &kp RALT  &kp BSPC  &kp DEL
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };
    };
};
